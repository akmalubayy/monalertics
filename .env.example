# ============================================================
# Monalertics — Environment Variables
# ============================================================

# --- Database (PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Local development (ganti sesuai setup lokal / shared hosting cPanel)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/monalertics?schema=public"

# --- App ---
NODE_ENV="development"
APP_URL="http://localhost:3000"

# --- Auth ---
JWT_SECRET="change-this-to-a-long-random-secret-string"
JWT_EXPIRES_IN="7d"

# --- Cron Protection ---
# Token rahasia untuk mengamankan endpoint /api/cron/run
CRON_SECRET="change-this-cron-secret"

# --- Email (SMTP) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Monalertics <noreply@monalertics.com>"

# --- Screenshot Provider ---
# Provider eksternal untuk capture screenshot (shared-hosting friendly)
SCREENSHOT_PROVIDER="pagespeed"
SCREENSHOT_API_KEY=""
